# ==============================================================================
# MOM'S KITCHEN - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, or configure these
# in your hosting dashboard (Vercel, Netlify, Cloudflare, VPS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anon Key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Secret Key (found in Project Settings > API > service_role)
# CRITICAL: Keep secret! Used on Next.js server to verify subscriber status & record votes.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. BOT & SPAM PROTECTION - GOOGLE reCAPTCHA v3 (REQUIRED)
# ------------------------------------------------------------------------------
# Google reCAPTCHA v3 Public Site Key
# Make sure to register your live domain (e.g. yourdomain.com) in Google reCAPTCHA Console
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Google reCAPTCHA v3 Server Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# Optional: Minimum score threshold (0.0 to 1.0, defaults to 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ------------------------------------------------------------------------------
# 3. APPLICATION & SEO (RECOMMENDED)
# ------------------------------------------------------------------------------
# Canonical public URL of your live website (no trailing slash)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 4. DATABASE MIGRATIONS / SCRIPTS ONLY (OPTIONAL)
# ------------------------------------------------------------------------------
# Used only by CLI migration scripts (e.g., node scripts/apply-voting-migration.mjs)
# SUPABASE_DB_PASSWORD=your_database_password
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
